# ============================================================
# Biến môi trường của agent. Dùng: cp .env.example .env
# File .env nằm trong .gitignore — KHÔNG commit. Không ghi secret thật vào file này.
# ============================================================

# Server
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security — đặt chuỗi ngẫu nhiên dài, vd: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=

# Redis (trong docker compose được ghi đè thành redis://redis:6379/0)
REDIS_URL=redis://localhost:6379/0

# Rate limit: số request tối đa / 60 giây cho mỗi API key
RATE_LIMIT_PER_MINUTE=10

# Cost guard (USD) — vượt thì /ask trả 402
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
